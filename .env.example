# Web service
PORT=5000
NODE_ENV=production
JWT_SECRET=change-this-to-a-long-random-string

# Local PostgreSQL (use these when DATABASE_URL is not set)
DB_USER=job_user
DB_HOST=localhost
DB_NAME=job_tracker
DB_PASSWORD=your_password_here
DB_PORT=5432

# Render sets this automatically when you link a Postgres database
# DATABASE_URL=postgres://user:pass@host:5432/dbname
